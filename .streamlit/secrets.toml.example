# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App -> Settings -> Secrets.
# Every key is optional: missing keys fall back to template emails / on-screen outbox / simulated calls.

# --- AI (either one) ---
ANTHROPIC_API_KEY = ""
CLAUDE_MODEL = "claude-opus-5-5"
GEMINI_API_KEY = ""

# --- Email (Gmail: enable 2-Step Verification, then create an App Password) ---
SMTP_USER = "yourteam@gmail.com"
SMTP_APP_PASSWORD = ""

# --- Auto-call (Twilio trial: verify the number you will call) ---
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM = "+1xxxxxxxxxx"

# --- Demo safety: redirect ALL emails / calls here so judges never spam real people ---
DEMO_INBOX = "yourteam@gmail.com"
DEMO_PHONE = "+91xxxxxxxxxx"

# --- Weekly summary recipient (HOD / admin) and public app URL for booking links ---
SUMMARY_TO = "yourteam@gmail.com"
APP_URL = "https://your-app.streamlit.app"
